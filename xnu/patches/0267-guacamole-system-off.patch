+int
+sweet_ufs_shutdown(void)
+{
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = !su.ready ? ENXIO : su.stopped ? 0 : ufs_sync_cache();
+	if (!error) {
+		/* The log writer shares this lock; no I/O may follow the final flush. */
+		su.stopped = true;
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
