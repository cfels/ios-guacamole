 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int sweet_ufs_shutdown(void);
+
+static int32_t
+sweet_psci(uint32_t function, uint32_t argument)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	register uint64_t x1 __asm__("x1") = argument;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
+	int32_t systemOffFeature = -1;
 
 public:
 	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	int haltRestart(unsigned int type) APPLE_KEXT_OVERRIDE;
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
@@ -29,9 +47,34 @@
 	if (!IODTPlatformExpert::start(provider)) {
 		return false;
 	}
+	int32_t version = sweet_psci(0x84000000, 0);
+	if (version >= 0x10000)
+		systemOffFeature = sweet_psci(0x8400000a, 0x84000008);
+	IOLog("SWEET POWER: PSCI version=%#x SYSTEM_OFF feature=%d\n", version, systemOffFeature);
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
 	return true;
+}
+
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	if (type != kPEHaltCPU && type != kPEUPSDelayHaltCPU)
+		return IODTPlatformExpert::haltRestart(type);
+	if (systemOffFeature < 0) {
+		IOLog("SWEET POWER: SYSTEM_OFF unsupported, shutdown failed\n");
+		return -1;
+	}
+	IOLog("SWEET POWER: final UFS flush before SYSTEM_OFF\n");
+	int error = sweet_ufs_shutdown();
+	if (error) {
+		IOLog("SWEET POWER: UFS flush failed=%d, shutdown aborted\n", error);
+		return -1;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	int32_t result = sweet_psci(0x84000008, 0);
+	IOLog("SWEET POWER: SYSTEM_OFF returned=%d, shutdown failed\n", result);
+	return -1;
 }
 
